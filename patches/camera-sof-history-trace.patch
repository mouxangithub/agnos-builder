--- a/drivers/media/platform/msm/camera/cam_isp/isp_hw_mgr/isp_hw/ife_csid_hw/cam_ife_csid_core.c
+++ b/drivers/media/platform/msm/camera/cam_isp/isp_hw_mgr/isp_hw/ife_csid_hw/cam_ife_csid_core.c
@@ -21,6 +21,7 @@
 #include "cam_io_util.h"
 #include "cam_debug_util.h"
 #include "cam_cpas_api.h"
+#include "cam_trace.h"
 
 /* Timeout value in msec */
 #define IFE_CSID_TIMEOUT                               1000
@@ -2092,6 +2093,39 @@
 	time_stamp->boot_timestamp = (uint64_t)((ts.tv_sec * 1000000000) +
 		ts.tv_nsec);
 
+	/* Read history only while explicitly tracing. Re-read current to expose
+	 * a SOF register update during the sample instead of claiming a gap.
+	 * The existing timestamp and all runtime decisions stay unchanged.
+	 */
+	if (trace_cam_csid_sof_history_enabled()) {
+		uint32_t prev_hi, prev_lo, curr_hi, curr_lo;
+		uint64_t previous, verify;
+
+		if (res->res_id == CAM_IFE_PIX_PATH_RES_IPP) {
+			prev_hi = csid_reg->ipp_reg->csid_ipp_timestamp_perv1_sof_addr;
+			prev_lo = csid_reg->ipp_reg->csid_ipp_timestamp_perv0_sof_addr;
+			curr_hi = csid_reg->ipp_reg->csid_ipp_timestamp_curr1_sof_addr;
+			curr_lo = csid_reg->ipp_reg->csid_ipp_timestamp_curr0_sof_addr;
+		} else {
+			rdi_reg = csid_reg->rdi_reg[res->res_id];
+			prev_hi = rdi_reg->csid_rdi_timestamp_prev1_sof_addr;
+			prev_lo = rdi_reg->csid_rdi_timestamp_prev0_sof_addr;
+			curr_hi = rdi_reg->csid_rdi_timestamp_curr1_sof_addr;
+			curr_lo = rdi_reg->csid_rdi_timestamp_curr0_sof_addr;
+		}
+		previous = (uint64_t)cam_io_r_mb(soc_info->reg_map[0].mem_base + prev_hi) << 32;
+		previous |= cam_io_r_mb(soc_info->reg_map[0].mem_base + prev_lo);
+		verify = (uint64_t)cam_io_r_mb(soc_info->reg_map[0].mem_base + curr_hi) << 32;
+		verify |= cam_io_r_mb(soc_info->reg_map[0].mem_base + curr_lo);
+		previous = mul_u64_u32_div(previous, CAM_IFE_CSID_QTIMER_MUL_FACTOR,
+			CAM_IFE_CSID_QTIMER_DIV_FACTOR);
+		verify = mul_u64_u32_div(verify, CAM_IFE_CSID_QTIMER_MUL_FACTOR,
+			CAM_IFE_CSID_QTIMER_DIV_FACTOR);
+		trace_cam_csid_sof_history(csid_hw->hw_intf->hw_idx, res->res_id,
+			time_stamp->time_stamp_val, previous, verify,
+			time_stamp->boot_timestamp);
+	}
+
 	return 0;
 }
 
