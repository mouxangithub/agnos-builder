@@ -27,6 +27,53 @@
 #include "cam_req_mgr_interface.h"
 #include "cam_context.h"
 
+/* Passive experiment diagnostics. No printk or persistent per-frame log. */
+TRACE_EVENT(cam_csid_sof_history,
+	TP_PROTO(uint32_t hw, uint32_t res, uint64_t current_ns,
+		uint64_t previous_ns, uint64_t verify_ns, uint64_t boot_ns),
+	TP_ARGS(hw, res, current_ns, previous_ns, verify_ns, boot_ns),
+	TP_STRUCT__entry(
+		__field(uint32_t, hw)
+		__field(uint32_t, res)
+		__field(uint64_t, current_ns)
+		__field(uint64_t, previous_ns)
+		__field(uint64_t, verify_ns)
+		__field(uint64_t, boot_ns)
+	),
+	TP_fast_assign(
+		__entry->hw = hw;
+		__entry->res = res;
+		__entry->current_ns = current_ns;
+		__entry->previous_ns = previous_ns;
+		__entry->verify_ns = verify_ns;
+		__entry->boot_ns = boot_ns;
+	),
+	TP_printk("CSID hw=%u res=%u current_ns=%llu previous_ns=%llu verify_ns=%llu boot_ns=%llu",
+		__entry->hw, __entry->res, __entry->current_ns,
+		__entry->previous_ns, __entry->verify_ns, __entry->boot_ns)
+);
+
+TRACE_EVENT(cam_ife_irq_payload,
+	TP_PROTO(uint32_t hw, uint32_t status0, uint32_t status1,
+		uint64_t irq_boot_ns),
+	TP_ARGS(hw, status0, status1, irq_boot_ns),
+	TP_STRUCT__entry(
+		__field(uint32_t, hw)
+		__field(uint32_t, status0)
+		__field(uint32_t, status1)
+		__field(uint64_t, irq_boot_ns)
+	),
+	TP_fast_assign(
+		__entry->hw = hw;
+		__entry->status0 = status0;
+		__entry->status1 = status1;
+		__entry->irq_boot_ns = irq_boot_ns;
+	),
+	TP_printk("IFE hw=%u status0=0x%x status1=0x%x irq_boot_ns=%llu",
+		__entry->hw, __entry->status0, __entry->status1,
+		__entry->irq_boot_ns)
+);
+
